# 非秘密配置保存在 BOOK_DATA_DIR/.settings/settings.json；该文件不再保存供应商明文密钥。
# 默认 ENV_ONLY：凭据由进程环境注入，网页只能更改非秘密设置。
# 需要网页写入凭据：先选择 ENCRYPTED_FILE，并在仓库外安全注入下面的主密钥与部署身份。
# 主密钥须为随机 32 字节的标准 Base64；不得提交、打印到日志或与密文备份放在一起。
# 部署身份与 keyId 在已有密文后不可随意改变；它们参与完整性校验。
# 旧明文 settings.json 有凭据时，升级前先阅读 docs/verification/final-r1-secret-storage-20260922.md。
BOOK_SECRET_STORE_MODE=ENV_ONLY
BOOK_SECRET_MASTER_KEY=
BOOK_SECRET_DEPLOYMENT_ID=
BOOK_SECRET_KEY_ID=primary
PORT=18765
BOOK_DATA_DIR=./data
# 建议部署时将 BOOK_DATA_DIR 设置为仓库外绝对路径。

# 百度智能云应用：PP-OCRv6（官方请求路径仍为 pp_ocrv5）。
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 飞桨 AI Studio：默认 OCR 通道，Access Token 独立认证。
PADDLEOCR_ACCESS_TOKEN=
PADDLE_AISTUDIO_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLE_AISTUDIO_MODEL=PaddleOCR-VL-1.6
PADDLE_AISTUDIO_REQUEST_TIMEOUT_SECONDS=60
PADDLE_AISTUDIO_TOTAL_TIMEOUT_SECONDS=180
PADDLE_AISTUDIO_POLL_INTERVAL_SECONDS=5

# 可选 Qwen：密钥、模型与地域应一致；配置不构成自动外发授权。
DASHSCOPE_API_KEY=
QWEN_ASSIST_ENABLED=false
QWEN_ASSIST_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASSIST_MODEL=qwen3.8-max

# JEV 默认关闭；授权与调用预算沿用既有门禁。
# ENCRYPTED_FILE 可在界面更新密钥；ENV_ONLY 通过已有部署环境变量注入。
# 参考单价缺失时仍记录请求，用量未知不视为 0 元。
# JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home

# 本机默认绑定；只有主动开放局域网才设置 BIND=0.0.0.0（仍无多用户登录）。
BIND=127.0.0.1
# 使用 MacBook.local 等局域网名称时显式允许，IP 访问无需填写；不支持通配符。
BOOK_ALLOWED_HOSTS=
# 已主动开始的 OCR 漏检疑似文字时，至多增加 4 个同通道区域操作；供应商内部重试仍计费。
# 设置 false 关闭补识，但不会恢复“空结果=空白”的错误判断。
OCR_REGION_RECOVERY=true
