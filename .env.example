# 复制为 .env 后按需填写；.env 不应提交或分享。
PORT=18765
BOOK_DATA_DIR=./data
TESSERACT_COMMAND=tesseract

# 百度智能云 PaddleOCR-VL 1.6（默认通道，消耗 AK/SK 所属账户额度）。
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
PADDLE_OCR_MODEL=PaddleOCR-VL-1.6

# AI Studio PaddleOCR-VL 1.6（独立可选通道，不与上方凭据或缓存混用）。
PADDLEOCR_ACCESS_TOKEN=
PADDLE_AISTUDIO_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLE_AISTUDIO_MODEL=PaddleOCR-VL-1.6
PADDLE_AISTUDIO_REQUEST_TIMEOUT_SECONDS=60
PADDLE_AISTUDIO_TOTAL_TIMEOUT_SECONDS=180
PADDLE_AISTUDIO_POLL_INTERVAL_SECONDS=5

# 阿里云 Qwen 结构辅助；同一密钥也保留给旧 Qwen OCR 手动兼容通道。
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen3.5-ocr
QWEN_ASSIST_ENABLED=true
QWEN_ASSIST_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASSIST_MODEL=qwen3.8-max

# MiniMax M3 图片理解 API。视频生成接口不适用于文字识别。
MINIMAX_ASSIST_ENABLED=false
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=

# 本机 Maven 默认 JDK 与 java 可能不同，必要时指定 JDK 17 或以上。
# JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home
